          },
          "400": { "$ref": "#/responses/BadRequest" },
          "404": { "$ref": "#/responses/NotFound" },
          "409": { "$ref": "#/responses/Conflict" }
        },
        "x-codeSamples": [
          { "lang": "cURL", "label": "cURL - crear pedido", "source": "curl -X POST \"http://localhost:3000/api/pedido/\" -H \"Content-Type: application/json\" -d '{\"direccionId\":1}'" }
        ]
      }
    },

