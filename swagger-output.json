        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/PedidoCreate" } }
        ],
        "responses": {
          "201": { 
            "description": "Pedido creado", 
            "schema": { "$ref": "#/definitions/PedidoCreateResponse" },
