          "404": { "$ref": "#/responses/NotFound" }
        }
      }
    },

    "/api/bitacora/": {
      "get": {
        "tags": ["Bitacora"],
        "summary": "Listar entradas de bitácora",
        "description": "Devuelve las entradas ordenadas por fecha descendente",
        "responses": {
          "200": { 
            "description": "OK", 
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Bitacora" } },
            "examples": {
              "application/json": [
                { 
                  "bitacoraId": "b1",
                  "accion": "usuario.login",
                  "elementoid": "user@example.com",
                  "ip": "192.168.1.100",
                  "usuario": "admin@example.com",
                  "fecha": "2025-11-10T12:00:00Z"
                }
              ]
            }
          }
        }
      }
    },

    "/api/carrito/": {
      "get": {
        "tags": ["Carrito"],
        "summary": "Obtener carrito del usuario (sesión)",
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/Carrito" } },
          "404": { "$ref": "#/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Carrito"],
        "summary": "Vaciar carrito",
        "responses": { "204": { "description": "No Content - carrito vaciado" } },
        "x-codeSamples": [
          { "lang": "cURL", "label": "cURL - vaciar carrito", "source": "curl -X DELETE \"http://localhost:3000/api/carrito/\" -H \"Accept: application/json\"" }
        ]
      }
    },

    "/api/carrito/items": {
      "post": {
        "tags": ["Carrito"],
        "summary": "Agregar item al carrito",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CarritoItemCreate" } }
        ],
        "responses": {
          "201": { "description": "Item agregado", "schema": { "$ref": "#/definitions/CarritoItem" } },
          "404": { "$ref": "#/responses/NotFound" },
          "409": { "$ref": "#/responses/Conflict" }
        },
        "x-codeSamples": [
          { "lang": "cURL", "label": "cURL - agregar item", "source": "curl -X POST \"http://localhost:3000/api/carrito/items\" -H \"Content-Type: application/json\" -d '{\"productoId\":\"p1\",\"cantidad\":2}'" }
        ]
      }
    },

