@startuml
' Clases existentes (resumidas)
class Usuario {
  +id: string
  +email: string
  +passwordHash: string
  +nombre: string
  +protegido: boolean
  +rolId: string
}
class Rol {
  +id: string
  +nombre: string
}
class Producto {
  +id: int
  +titulo: string
  +descripcion: text
  +precio: decimal
  +archivoId: int
  +stock: int
  +activo: boolean
}
class Archivo {
  +id: int
  +mime: string
  +nombre: string
  +size: int
  +indb: boolean
  +datos: blob
}
class Categoria {
  +id: int
  +nombre: string
  +protegida: boolean
}
class Bitacora {
  +id: int
  +accion: string
  +elementoId: string
  +ip: string
  +usuario: string
  +fecha: date
}

' Nuevas clases para carrito y pedido
class Carrito {
  +id: int
  +usuarioId: string
  +creadoEn: date
  +actualizadoEn: date
}
class CarritoItem {
  +id: int
  +carritoId: int
  +productoId: int
  +cantidad: int
  +precioUnitario: decimal
}
class Pedido {
  +id: int
  +usuarioId: string
  +direccionId: int
  +total: decimal
  +estado: string
  +creadoEn: date
}
class PedidoItem {
  +id: int
  +pedidoId: int
  +productoId: int
  +cantidad: int
  +precioUnitario: decimal
}
class Direccion {
  +id: int
  +usuarioId: string
  +calle: string
  +ciudad: string
  +estado: string
  +codigoPostal: string
  +pais: string
}
class Pago {
  +id: int
  +pedidoId: int
  +metodo: string
  +importe: decimal
  +estadoPago: string
  +referencia: string
  +creadoEn: date
}

' Relaciones
Usuario "1" -- "0..1" Carrito
Carrito "1" -- "0..*" CarritoItem
CarritoItem "*" -- "1" Producto

Usuario "1" -- "0..*" Pedido
Pedido "1" -- "0..*" PedidoItem
PedidoItem "*" -- "1" Producto

Pedido "1" -- "0..1" Pago
Usuario "1" -- "0..*" Direccion
Producto "*" -- "*" Categoria : <<through categoriaproducto>>
Producto "0..1" -- "1" Archivo

Usuario "1" -- "1" Rol
@enduml
